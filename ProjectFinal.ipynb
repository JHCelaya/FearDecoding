   "source": [
    "from scipy.stats import pearsonr\n",
    "\n",
    "correlations = {\n",
    "    neuron: pearsonr(df[neuron], df['suppression_mean'])[0]\n",
    "    for neuron in df.columns if neuron.startswith('neuron_')\n",
