    "\n",
    "# Load the core structures, Now we are putting it all together\n",
    "fire_data = data['fire'].item()['z']['ms500']['interval']\n",
    "cer_data = data['cer'].item()['ms500']['interval']\n",
    "poke_data = data['poke'].item()['ms500']['interval']\n",
    "\n",
    "# Step 1: summarize firing data across time (mean per neuron per trial)\n",
    "X_firing = fire_data.mean(axis=1)  # shape: (16, 435)\n",
    "neuron_cols = [f\"neuron_{i}\" for i in range(X_firing.shape[1])]\n",
    "df = pd.DataFrame(X_firing, columns=neuron_cols)\n",
    "df['trial'] = np.arange(X_firing.shape[0])\n",
    "\n",
    "df.head()"
   ]
