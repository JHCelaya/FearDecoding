    "\n",
    "# Optional sanity check:\n",
    "print(\"Class order:\", clf.classes_)  # should show: array([0, 1])\n",
    "\n",
    "# If the ROC curve is inverted, flip the probabilities\n",
    "y_prob_flipped = 1 - y_prob\n",
    "\n",
    "# Compute ROC curve and AUC\n",
    "fpr, tpr, _ = roc_curve(y, y_prob_flipped)\n",
    "roc_auc = auc(fpr, tpr)\n",
    "\n",
    "# Plot ROC curve\n",
    "plt.figure(figsize=(6, 5))\n",
    "plt.plot(fpr, tpr, label=f\"ROC Curve (Flipped AUC = {roc_auc:.2f})\", color='blue')\n",
    "plt.plot([0, 1], [0, 1], 'k--', label='Chance')\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.title(\"SVM ROC Curve with Flipped Probabilities\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
