   "source": [
    "from scipy.stats import pearsonr\n",
    "\n",
    "# Subset neuron columns\n",
    "neuron_cols = [col for col in df.columns if col.startswith('neuron_')]\n",
    "\n",
    "# Group by cue type\n",
    "correlation_results = {}\n",
    "for cue in df['cue_type'].unique():\n",
    "    sub = df[df['cue_type'] == cue]\n",
    "    correlations = {\n",
    "        neuron: pearsonr(sub[neuron], sub['suppression_mean'])[0]\n",
    "        for neuron in neuron_cols\n",
    "    }\n",
    "    correlation_results[cue] = correlations\n",
    "\n",
    "# Convert to DataFrame for heatmap or ranking\n",
    "correlation_df = pd.DataFrame(correlation_results)\n",
    "correlation_df"
   ]
  },
